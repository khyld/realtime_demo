AZURE_OPENAI_RESOURCE=
AZURE_OPENAI_REALTIME_DEPLOYMENT=gpt-realtime-1.5
AZURE_OPENAI_TRANSCRIPTION_DEPLOYMENT=gpt-4o-mini-transcribe
AZURE_OPENAI_VOICE=coral
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=knowledge-chunks
AZURE_SEARCH_INDEXER_NAME=knowledge-indexer
